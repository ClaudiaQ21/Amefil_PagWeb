-- Tabla ubigeo
CREATE TABLE ubigeo (
    id_ubigeo INT(10) PRIMARY KEY AUTO_INCREMENT,
    departamento VARCHAR(100) NOT NULL,
    provincia VARCHAR(100) NOT NULL,
    distrito VARCHAR(100) NOT NULL,
    UNIQUE(departamento, provincia, distrito)  -- Restricción UNIQUE
);

-- Tabla direccion
CREATE TABLE direccion (
    id_direccion INT(10) PRIMARY KEY AUTO_INCREMENT,
    detalle VARCHAR(250) NOT NULL,
    id_ubigeo INT(10) NOT NULL,
    FOREIGN KEY (id_ubigeo) REFERENCES ubigeo(id_ubigeo)
);

-- Tabla tipo_usuario
CREATE TABLE tipo_usuario (
    id_tipo INT(10) PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(100) NOT NULL UNIQUE  -- Restricción UNIQUE
);

-- Tabla usuario
CREATE TABLE usuario (
    id_usuario INT(10) PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(150) NOT NULL,
    apellido_p VARCHAR(150) NOT NULL,
    apellido_m VARCHAR(150) NOT NULL,
    correo VARCHAR(300) NOT NULL UNIQUE,  -- Restricción UNIQUE
    contrasena VARCHAR(25) NOT NULL,
    telefono CHAR(9) NOT NULL UNIQUE,  -- Restricción UNIQUE
    genero BOOLEAN,  -- Cambiado a BOOLEAN
    nacimiento DATE NOT NULL,
    id_tipo INT(10) NOT NULL,
    id_direccion INT(10) NOT NULL,
    FOREIGN KEY (id_tipo) REFERENCES tipo_usuario(id_tipo),
    FOREIGN KEY (id_direccion) REFERENCES direccion(id_direccion)
);

-- Tabla color
CREATE TABLE color (
    id_color INT(10) PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(50) NOT NULL UNIQUE  -- Restricción UNIQUE
);

-- Tabla temporada
CREATE TABLE temporada (
    id_temporada INT(10) PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(50) NOT NULL UNIQUE  -- Restricción UNIQUE
);

-- Tabla talla
CREATE TABLE talla (
    id_talla INT(10) PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(5) NOT NULL UNIQUE,  -- Restricción UNIQUE
    minimo FLOAT NOT NULL,
    maximo FLOAT NOT NULL
);

-- Tabla tipo_producto
CREATE TABLE tipo_producto (
    id_tipo INT(10) PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(50) NOT NULL UNIQUE  -- Restricción UNIQUE
);

-- Tabla producto
CREATE TABLE producto (
    id_producto INT(10) PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(100) NOT NULL,
    precio FLOAT NOT NULL,
    vigencia BOOLEAN NOT NULL,  -- Cambiado a BOOLEAN
    stock INT(10) NOT NULL,
    descripcion VARCHAR(300),
    id_color INT(10) NOT NULL,
    id_temporada INT(10) NOT NULL,
    id_tipo INT(10) NOT NULL,
    id_talla INT(10) NOT NULL,
    imagen LONGBLOB,
    FOREIGN KEY (id_color) REFERENCES color(id_color),
    FOREIGN KEY (id_temporada) REFERENCES temporada(id_temporada),
    FOREIGN KEY (id_tipo) REFERENCES tipo_producto(id_tipo),
    FOREIGN KEY (id_talla) REFERENCES talla(id_talla)
);

-- Tabla descuento
CREATE TABLE descuento (
    id_descuento INT(10) PRIMARY KEY AUTO_INCREMENT,
    tasa FLOAT NOT NULL,
    fecha_inicio DATE NOT NULL,
    fecha_fin DATE NOT NULL,
    vigencia BOOLEAN NOT NULL  -- Cambiado a BOOLEAN
);

-- Tabla detalle_descuento (Many-to-Many entre producto y descuento)
CREATE TABLE detalle_descuento (
    id_producto INT(10) NOT NULL,
    id_descuento INT(10) NOT NULL,
    PRIMARY KEY (id_producto, id_descuento),
    FOREIGN KEY (id_producto) REFERENCES producto(id_producto),
    FOREIGN KEY (id_descuento) REFERENCES descuento(id_descuento)
);

-- Tabla pedido_cesta
CREATE TABLE pedido_cesta (
    id_pedido INT(10) PRIMARY KEY AUTO_INCREMENT,
    id_usuario INT(10) NOT NULL,
    fecha_registro DATE NOT NULL,
    FOREIGN KEY (id_usuario) REFERENCES usuario(id_usuario)
);

-- Tabla detalle_cesta
CREATE TABLE detalle_cesta (
    id_detalle INT(10) PRIMARY KEY AUTO_INCREMENT,
    cantidad INT(10) NOT NULL,
    total FLOAT NOT NULL,
    id_producto INT(10) NOT NULL,
    id_pedido INT(10) NOT NULL,
    FOREIGN KEY (id_producto) REFERENCES producto(id_producto),
    FOREIGN KEY (id_pedido) REFERENCES pedido_cesta(id_pedido)
);

-- Tabla favoritos (Many-to-Many entre usuario y producto)
CREATE TABLE favoritos (
    id_usuario INT(10) NOT NULL,
    id_producto INT(10) NOT NULL,
    PRIMARY KEY (id_usuario, id_producto),
    FOREIGN KEY (id_usuario) REFERENCES usuario(id_usuario),
    FOREIGN KEY (id_producto) REFERENCES producto(id_producto)
);





-- PROCEDIMIENTOS ALMACENADOS

CREATE PROCEDURE EliminarDetalleCesta (
    IN p_idProducto INT, 
    IN p_idPedido INT, 
    IN p_idUsuario INT
)   
BEGIN
    DECLARE v_estado tinyint(1);
    DECLARE v_total float;

    -- Iniciar la transacción
    START TRANSACTION;

    -- Verificar que el carrito pertenece al usuario y está en estado 'P'
    SELECT estado INTO v_estado
    FROM pedido_cesta
    WHERE id_pedido = p_idPedido AND id_usuario = p_idUsuario AND estado = 0;

    IF v_estado = 0 THEN
        DELETE FROM detalle_cesta
        WHERE id_pedido = p_idPedido AND id_producto = p_idProducto;

        -- Recalcular el subtotal del carrito
        SELECT SUM(cantidad * precio) INTO v_total
        FROM detalle_cesta
        WHERE id_pedido = p_idPedido;

        -- Si no hay detalles restantes, el subtotal será 0
        IF v_total IS NULL THEN
            SET v_total = 0;
        END IF;

        -- Actualizar el subtotal en el carrito
        UPDATE pedido_cesta
        SET monto_total = v_total
        WHERE id_pedido = p_idPedido;

        -- Confirmar la transacción
        COMMIT;
    ELSE
        -- Si el carrito no está en estado 'P', deshacer la transacción
        ROLLBACK;
    END IF;

END




CREATE DEFINER=root@localhost PROCEDURE finalizarCompra (
    IN p_idPedido INT, 
    IN p_idDireccion INT, 
    IN p_idUsuario INT
)
BEGIN
    -- Declaración de variables
    DECLARE v_fecha DATE;
    DECLARE v_hora TIME;
    DECLARE v_montoTotal FLOAT;
    DECLARE v_idProducto INT;
    DECLARE v_cantidad INT;
    DECLARE done INT DEFAULT 0;

    -- Cursor para los detalles de la cesta
    DECLARE cur_detalles CURSOR FOR 
        SELECT id_producto, cantidad FROM Detalle_cesta WHERE id_pedido = p_idPedido;

    -- Handler para cerrar el cursor
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1;

    -- Iniciar la transacción
    START TRANSACTION;

    -- Verificar si el pedido (cesta) pertenece al usuario dado
    IF EXISTS (SELECT 1 FROM pedido_cesta WHERE id_pedido = p_idPedido AND id_usuario = p_idUsuario) THEN
        
        -- Obtener la fecha y la hora actuales
        SET v_fecha = CURDATE();
        SET v_hora = CURTIME();

        -- Calcular el monto total del pedido
        SELECT monto_total INTO v_montoTotal
        FROM pedido_cesta
        WHERE id_pedido = p_idPedido;

        -- Cambiar el estado del pedido (por ejemplo, de '1' a '2', indicando completado)
        UPDATE pedido_cesta
        SET estado = 1, fecha_registro = v_fecha, hora_registro=v_hora  -- Supongo que 2 es el estado de completado
        WHERE id_pedido = p_idPedido;

        -- Iterar sobre los detalles del pedido
        OPEN cur_detalles;

        read_loop: LOOP
            FETCH cur_detalles INTO v_idProducto, v_cantidad;

            -- Si no hay más filas, salir del loop
            IF done = 1 THEN 
                LEAVE read_loop; 
            END IF;

            -- Descontar el stock del producto
            UPDATE Producto
            SET stock = stock - v_cantidad
            WHERE id_producto = v_idProducto;

            -- Verificar que el stock no haya quedado negativo
            IF (SELECT stock FROM Producto WHERE id_producto = v_idProducto) < 0 THEN
                -- Si el stock es negativo, revertir la transacción
                ROLLBACK;
                SIGNAL SQLSTATE '45000'
                SET MESSAGE_TEXT = 'Stock insuficiente para el producto.';
                LEAVE read_loop;
            END IF;

        END LOOP;

        CLOSE cur_detalles;

        COMMIT;

    ELSE
        ROLLBACK;
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'El pedido no pertenece al usuario especificado.';
    END IF;

END;
